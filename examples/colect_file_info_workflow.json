{
  "schema_version": "1",
  "flow_id": "colect_file_info_workflow",
  "start_node_id": "NODE_1",
  "nodes": [
    {
      "id": "NODE_1",
      "action_type": "function",
      "action_parameters": {
        "function_name": "save_paths_to_deque",
        "function_parameters": {
          "folder_path": "folder_path",
          "param_name": "paths_deque"
        }
      },
      "transitions": [
        {
          "next": "NODE_2"
        }
      ],
      "validators": [
        {
          "function_name": "chek_collection_state_param",
          "function_parameters": {
            "param_name": "paths_deque",
            "not_empty": true
          }
        }
      ],
      "set_parameters": {
        "folder_path": "C:\\out"
      }
    },
    {
      "id": "NODE_2",
      "action_type": "pop_from_queue",
      "action_parameters": {
        "queue_name": "paths_deque"
      },
      "validators": [
        {
          "function_name": "is_output_exist_file"
        }
      ],
      "transitions": [
        {
          "validator": {
            "function_name": "is_output_exist_file"
          },
          "next": "NODE_3"
        },
        {
          "validator": {
            "function_name": "is_output_exist_folder"
          },
          "next": "NODE_1"
        }
      ],
      "save_as": "path_from_queue"
    },
    {
      "id": "NODE_3",
      "action_type": "functions",
      "action_parameters": {
        "path": "param.path_from_queue",
        "functions": {
          "function_parameters": {
            "file_path": "param.path_from_queue"
          },
          "md5": {
            "function_name": "md5_check_sum_file"
          },
          "Size": {
            "function_name": "file_size"
          },
          "Created": {
            "function_name": "file_create_time"
          },
          "Modified": {
            "function_name": "file_modify_time"
          },
          "Accessed": {
            "function_name": "access_time"
          },
          "Mime": {
            "function_name": "file_mime_type"
          },
          "Encoding": {
            "function_name": "file_encoding"
          },
          "Executable": {
            "function_name": "file_executable"
          },
          "Permissions": {
            "function_name": "file_permissions"
          },
          "Owner": {
            "function_name": "file_owner"
          },
          "Symlink": {
            "function_name": "is_symlink"
          }
        },
        "save_to_list": "file_info_list"
      },
      "validators": [
        {
          "function_name": "is_output_exist_file"
        }
      ]
    }
  ]
}