{
  "schema_version": "1",
  "flow_id": "loop-start-pilot",
  "start_question_id": "Q_PROJECT_TYPE",
  "questions": [
    {
      "id": "Q_PROJECT_TYPE",
      "text": "What project type are we launching?",
      "input_mode": "choice",
      "required": true,
      "options": [
        {
          "value": "new_project",
          "label": "New project"
        },
        {
          "value": "existing_repo",
          "label": "Existing repository"
        }
      ],
      "options_type": "fixed",
      "validators": [
        {
          "type": "enum",
          "params": {
            "allowed": [
              "new_project",
              "existing_repo"
            ]
          },
          "on_fail": "retry_same"
        }
      ],
      "transitions": {
        "new_project": "Q_PROJECT_NAME",
        "existing_repo": "Q_REPO_PATH"
      },
      "persistence": {
        "artifact": "operator-interview-start.json",
        "field": "project.type",
        "policy": "set"
      }
    },
    {
      "id": "Q_PROJECT_NAME",
      "text": "Project name (short identifier)",
      "input_mode": "text",
      "required": true,
      "validators": [
        {
          "type": "non_empty",
          "on_fail": "retry_same"
        },
        {
          "type": "regex",
          "params": {
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "on_fail": "retry_same"
        }
      ],
      "next": "Q_GOAL",
      "persistence": {
        "artifact": "operator-interview-start.json",
        "field": "project.name",
        "policy": "set"
      }
    },
    {
      "id": "Q_REPO_PATH",
      "text": "Absolute repository path",
      "input_mode": "path",
      "required": true,
      "validators": [
        {
          "type": "path_exists",
          "on_fail": "retry_same"
        }
      ],
      "next": "Q_GOAL",
      "persistence": {
        "artifact": "operator-interview-start.json",
        "field": "project.repo_path",
        "policy": "set"
      }
    },
    {
      "id": "Q_GOAL",
      "text": "Describe feature goals and success criteria",
      "input_mode": "text",
      "required": true,
      "validators": [
        {
          "type": "non_empty",
          "on_fail": "retry_same"
        }
      ],
      "recommendation_policy": "required",
      "recommendation_hint": "Suggest concise REQUIREMENTS.md goal format",
      "recommended_answer": {
        "template": {
          "features": "...",
          "success_criteria": "...",
          "out_of_scope": "..."
        }
      },
      "next": "G_CONTEXT",
      "persistence": {
        "artifact": "operator-interview-start.json",
        "field": "goal.summary",
        "policy": "set"
      }
    },
    {
      "id": "G_CONTEXT",
      "type": "context_sufficiency_check",
      "text": "Is context sufficient to draft bootstrap-spec?",
      "check_instructions": "Use collected answers and constraints from loop-start interview.",
      "branches": {
        "sufficient": {
          "action": "go_to",
          "target": "C_READY"
        },
        "insufficient": {
          "action": "go_to",
          "target": "C_NEEDS_MORE"
        }
      }
    },
    {
      "id": "C_READY",
      "type": "completion",
      "instruction_ref": "loop-start:stage2-finalize"
    },
    {
      "id": "C_NEEDS_MORE",
      "type": "completion",
      "instruction_ref": "loop-start:collect-more-context"
    }
  ]
}

