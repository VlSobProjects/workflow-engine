{
  "schema_version": "1",
  "flow_id": "folder-inventory-to-csv-chunked",
  "start_node_id": "INIT_QUEUE",
  "inputs": [
    {
      "name": "scan_root",
      "type": "Path",
      "required": true,
      "description": "Root folder whose files are inventoried into the CSV report"
    },
    {
      "name": "described_formats",
      "type": "list",
      "required": true,
      "description": "MIME types whose files are read and described by the model, for example [\"text/plain\", \"text/markdown\"]"
    }
  ],
  "deliverables": [
    "file_scan_table"
  ],
  "nodes": [
    {
      "id": "INIT_QUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_deque_param",
        "function_parameters": {
          "param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "next": "INIT_ROWS"
        }
      ]
    },
    {
      "id": "INIT_ROWS",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_list_param",
        "function_parameters": {
          "param_name": "table_rows"
        }
      },
      "transitions": [
        {
          "next": "SEED_QUEUE"
        }
      ]
    },
    {
      "id": "SEED_QUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "enqueue_folder_entries",
        "function_parameters": {
          "folder_path": "param.scan_root",
          "deque_param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "next": "POP_NEXT"
        }
      ]
    },
    {
      "id": "POP_NEXT",
      "action_type": "function",
      "action_parameters": {
        "function_name": "set_param_from_deque",
        "function_parameters": {
          "deque_param_name": "scan_queue",
          "param_name": "cur_path",
          "on_empty": "empty",
          "on_set": "has_item"
        }
      },
      "transitions": [
        {
          "validator": {
            "equals": "empty"
          },
          "next": "WRITE_TABLE"
        },
        {
          "next": "EMIT_CUR_PATH"
        }
      ]
    },
    {
      "id": "EMIT_CUR_PATH",
      "action_type": "function",
      "action_parameters": {
        "function_name": "echo_value",
        "function_parameters": {
          "value": "param.cur_path"
        }
      },
      "transitions": [
        {
          "validator": {
            "function_name": "is_output_exist_file"
          },
          "next": "CLASSIFY_FORMAT"
        },
        {
          "next": "ENQUEUE"
        }
      ]
    },
    {
      "id": "CLASSIFY_FORMAT",
      "action_type": "function",
      "action_parameters": {
        "function_name": "file_mime_type",
        "function_parameters": {
          "file_path": "param.cur_path"
        }
      },
      "transitions": [
        {
          "validator": {
            "function_name": "is_output_in_collection",
            "function_parameters": {
              "collection": "param.described_formats"
            }
          },
          "next": "READ_FILE"
        },
        {
          "next": "NOT_DESCRIBED"
        }
      ]
    },
    {
      "id": "READ_FILE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "read_text_file",
        "function_parameters": {
          "file_path": "param.cur_path",
          "param_name": "file_text"
        }
      },
      "transitions": [
        {
          "errors": [
            "file_not_found",
            "file_not_text",
            "file_read_error"
          ],
          "next": "NOT_DESCRIBED"
        },
        {
          "next": "DESCRIBE"
        }
      ]
    },
    {
      "id": "DESCRIBE",
      "action_type": "llm",
      "action_parameters": {
        "provider": "local",
        "prompt": "You are given one file out of a folder inventory.\n\nFile: ${param.cur_path}\n\nContents:\n${param.file_text}\n\nWrite one sentence of at most 25 words saying what this file contains. Answer with the sentence alone, without a preamble and without quotes.",
        "answer": [
          {
            "name": "file_description",
            "description": "One sentence saying what the file contains"
          }
        ],
        "format": "text",
        "record": true
      },
      "max_attempts": 3,
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "COLLECT"
        },
        {
          "errors": [
            "transient",
            "rate_limited",
            "timeout",
            "llm_answer_invalid"
          ],
          "next": "DESCRIBE",
          "attempts": true
        },
        {
          "errors": [
            "context_overflow"
          ],
          "next": "SPLIT_TEXT"
        },
        {
          "fail": "description_unavailable"
        }
      ]
    },
    {
      "id": "NOT_DESCRIBED",
      "action_type": "function",
      "action_parameters": {
        "function_name": "echo_value",
        "function_parameters": {
          "value": "not described"
        }
      },
      "save_as": "file_description",
      "transitions": [
        {
          "next": "COLLECT"
        }
      ]
    },
    {
      "id": "COLLECT",
      "action_type": "functions",
      "action_parameters": {
        "save_to_list": "table_rows",
        "functions": {
          "Folder": {
            "function_name": "file_parent_folder",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Name": {
            "function_name": "file_name",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Size": {
            "function_name": "file_size_human",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "MIME": {
            "function_name": "file_mime_type",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Modified": {
            "function_name": "file_modify_time",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Description": {
            "function_name": "echo_value",
            "function_parameters": {
              "value": "param.file_description"
            }
          }
        }
      },
      "transitions": [
        {
          "next": "POP_NEXT"
        }
      ]
    },
    {
      "id": "ENQUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "enqueue_folder_entries",
        "function_parameters": {
          "folder_path": "param.cur_path",
          "deque_param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "next": "POP_NEXT"
        }
      ]
    },
    {
      "id": "WRITE_TABLE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "dict_list_to_pretty_table",
        "function_parameters": {
          "artifact_name": "file_scan_table",
          "dict_param_name": "table_rows",
          "artifact_path": "reports/file_scan_table.csv",
          "table_format": "csv"
        }
      },
      "transitions": [
        {
          "errors": [
            "pretty_table_no_data",
            "pretty_table_artifact_exists",
            "pretty_table_write_error"
          ]
        },
        {
          "stop": true
        }
      ]
    },
    {
      "id": "SPLIT_TEXT",
      "action_type": "function",
      "action_parameters": {
        "function_name": "split_text_to_deque",
        "function_parameters": {
          "text": "param.file_text",
          "param_name": "chunk_queue",
          "chunk_size": 2000
        }
      },
      "transitions": [
        {
          "errors": [
            "invalid_chunk_size",
            "split_not_text",
            "split_no_text"
          ],
          "next": "NOT_DESCRIBED"
        },
        {
          "next": "INIT_PARTS"
        }
      ]
    },
    {
      "id": "INIT_PARTS",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_list_param",
        "function_parameters": {
          "param_name": "part_descriptions",
          "allow_overwrite": true
        }
      },
      "transitions": [
        {
          "next": "POP_CHUNK"
        }
      ]
    },
    {
      "id": "POP_CHUNK",
      "action_type": "function",
      "action_parameters": {
        "function_name": "set_param_from_deque",
        "function_parameters": {
          "deque_param_name": "chunk_queue",
          "param_name": "cur_chunk",
          "on_empty": "empty",
          "on_set": "has_item"
        }
      },
      "transitions": [
        {
          "validator": {
            "equals": "empty"
          },
          "next": "SUMMARIZE_PARTS"
        },
        {
          "next": "DESCRIBE_CHUNK"
        }
      ]
    },
    {
      "id": "DESCRIBE_CHUNK",
      "action_type": "llm",
      "action_parameters": {
        "provider": "local",
        "prompt": "You are given one part of the file ${param.cur_path}, which is too large to read at once.\n\nPart:\n${param.cur_chunk}\n\nWrite one sentence of at most 25 words saying what this part contains. Answer with the sentence alone, without a preamble and without quotes.",
        "answer": [
          {
            "name": "chunk_description",
            "description": "One sentence saying what this part of the file contains"
          }
        ],
        "format": "text",
        "record": true
      },
      "max_attempts": 3,
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "APPEND_PART"
        },
        {
          "errors": [
            "transient",
            "rate_limited",
            "timeout",
            "llm_answer_invalid"
          ],
          "next": "DESCRIBE_CHUNK",
          "attempts": true
        },
        {
          "errors": [
            "context_overflow"
          ],
          "fail": "chunk_too_large"
        },
        {
          "fail": "description_unavailable"
        }
      ]
    },
    {
      "id": "APPEND_PART",
      "action_type": "function",
      "action_parameters": {
        "function_name": "append_to_param",
        "function_parameters": {
          "param_name": "part_descriptions",
          "value": "param.chunk_description"
        }
      },
      "transitions": [
        {
          "errors": [
            "param_not_found",
            "param_type_mismatch"
          ],
          "fail": "parts_not_collected"
        },
        {
          "next": "POP_CHUNK"
        }
      ]
    },
    {
      "id": "SUMMARIZE_PARTS",
      "action_type": "llm",
      "action_parameters": {
        "provider": "local",
        "prompt": "The file ${param.cur_path} was too large to read at once, so it was described part by part.\n\nThe descriptions of its parts, in order:\n${param.part_descriptions}\n\nWrite one sentence of at most 25 words saying what the whole file contains. Answer with the sentence alone, without a preamble and without quotes.",
        "answer": [
          {
            "name": "file_description",
            "description": "One sentence saying what the whole file contains"
          }
        ],
        "format": "text",
        "record": true
      },
      "max_attempts": 3,
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "COLLECT"
        },
        {
          "errors": [
            "transient",
            "rate_limited",
            "timeout",
            "llm_answer_invalid"
          ],
          "next": "SUMMARIZE_PARTS",
          "attempts": true
        },
        {
          "errors": [
            "context_overflow"
          ],
          "fail": "parts_too_large"
        },
        {
          "fail": "description_unavailable"
        }
      ]
    }
  ]
}
