{
  "schema_version": "1",
  "flow_id": "reorganize-folder",
  "start_node_id": "INIT_QUEUE",
  "inputs": [
    {
      "name": "scan_root",
      "type": "Path",
      "required": true,
      "description": "Root folder whose files are inventoried, classified and planned into a new structure"
    },
    {
      "name": "categories",
      "type": "list",
      "required": true,
      "description": "Closed list of category names the model must sort every file into, for example [\"documents\", \"code\", \"images\", \"data\", \"other\"]"
    }
  ],
  "deliverables": [
    "reorg_plan",
    "inventory_table"
  ],
  "nodes": [
    {
      "id": "INIT_QUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_deque_param",
        "function_parameters": {
          "param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "next": "INIT_ROWS"
        }
      ]
    },
    {
      "id": "INIT_ROWS",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_list_param",
        "function_parameters": {
          "param_name": "table_rows"
        }
      },
      "transitions": [
        {
          "next": "INIT_HASHES"
        }
      ]
    },
    {
      "id": "INIT_HASHES",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_dict_param",
        "function_parameters": {
          "param_name": "hash_groups"
        }
      },
      "transitions": [
        {
          "next": "INIT_CATEGORIES"
        }
      ]
    },
    {
      "id": "INIT_CATEGORIES",
      "action_type": "function",
      "action_parameters": {
        "function_name": "init_dict_param",
        "function_parameters": {
          "param_name": "file_categories"
        }
      },
      "transitions": [
        {
          "next": "SEED_QUEUE"
        }
      ]
    },
    {
      "id": "SEED_QUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "enqueue_folder_entries",
        "function_parameters": {
          "folder_path": "param.scan_root",
          "deque_param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "errors": [
            "folder_not_found"
          ],
          "fail": "scan_root_missing"
        },
        {
          "next": "POP_NEXT"
        }
      ]
    },
    {
      "id": "POP_NEXT",
      "action_type": "function",
      "action_parameters": {
        "function_name": "set_param_from_deque",
        "function_parameters": {
          "deque_param_name": "scan_queue",
          "param_name": "cur_path",
          "on_empty": "empty",
          "on_set": "has_item"
        }
      },
      "transitions": [
        {
          "errors": [
            "deque_not_found"
          ],
          "fail": "queue_lost"
        },
        {
          "guard": {
            "equals": "empty"
          },
          "next": "FIND_DUPLICATES"
        },
        {
          "next": "EMIT_CUR_PATH"
        }
      ]
    },
    {
      "id": "EMIT_CUR_PATH",
      "action_type": "function",
      "action_parameters": {
        "function_name": "echo_value",
        "function_parameters": {
          "value": "param.cur_path"
        }
      },
      "transitions": [
        {
          "guard": {
            "function_name": "is_output_exist_file"
          },
          "next": "HASH_FILE"
        },
        {
          "next": "ENQUEUE"
        }
      ]
    },
    {
      "id": "ENQUEUE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "enqueue_folder_entries",
        "function_parameters": {
          "folder_path": "param.cur_path",
          "deque_param_name": "scan_queue"
        }
      },
      "transitions": [
        {
          "errors": [
            "folder_not_found"
          ],
          "next": "POP_NEXT"
        },
        {
          "next": "POP_NEXT"
        }
      ]
    },
    {
      "id": "HASH_FILE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "md5_check_sum_file",
        "function_parameters": {
          "file_path": "param.cur_path"
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "COLLECT"
        },
        {
          "fail": "hash_unavailable"
        }
      ]
    },
    {
      "id": "COLLECT",
      "action_type": "functions",
      "action_parameters": {
        "save_to_list": "table_rows",
        "functions": {
          "Folder": {
            "function_name": "file_parent_folder",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Name": {
            "function_name": "file_name",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "Size": {
            "function_name": "file_size_human",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "MIME": {
            "function_name": "file_mime_type",
            "function_parameters": {
              "file_path": "param.cur_path"
            }
          },
          "MD5": {
            "function_name": "echo_value",
            "function_parameters": {
              "value": "output.HASH_FILE"
            }
          }
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "APPEND_HASH"
        },
        {
          "fail": "row_unavailable"
        }
      ]
    },
    {
      "id": "APPEND_HASH",
      "action_type": "function",
      "action_parameters": {
        "function_name": "append_to_dict_key",
        "function_parameters": {
          "dict_param_name": "hash_groups",
          "key": "output.HASH_FILE",
          "value": "param.cur_path"
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "CLASSIFY"
        },
        {
          "fail": "grouping_lost"
        }
      ]
    },
    {
      "id": "CLASSIFY",
      "action_type": "llm",
      "action_parameters": {
        "provider": "local",
        "prompt": "You are sorting one file of a folder inventory into a category.\n\nFile: ${param.cur_path}\n\nThe category list, closed: ${param.categories}\n\nAnswer as a JSON object with exactly two members: \"file_category\", one name from the category list above, and \"category_reason\", one short sentence saying why. Answer with the JSON object alone, without a preamble and without code fences.",
        "answer": [
          {
            "name": "file_category",
            "description": "One category name from the configured list"
          },
          {
            "name": "category_reason",
            "description": "One short sentence saying why the file belongs there"
          }
        ],
        "format": "json",
        "record": true
      },
      "max_attempts": 3,
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "SET_CATEGORY"
        },
        {
          "errors": [
            "transient",
            "rate_limited",
            "timeout",
            "llm_answer_invalid"
          ],
          "next": "CLASSIFY",
          "attempts": true
        },
        {
          "fail": "file_unclassifiable"
        }
      ]
    },
    {
      "id": "SET_CATEGORY",
      "action_type": "function",
      "action_parameters": {
        "function_name": "set_dict_item",
        "function_parameters": {
          "dict_param_name": "file_categories",
          "key": "param.cur_path",
          "value": "param.file_category"
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "POP_NEXT"
        },
        {
          "fail": "categories_lost"
        }
      ]
    },
    {
      "id": "FIND_DUPLICATES",
      "action_type": "function",
      "action_parameters": {
        "function_name": "filter_dict_by_value_size",
        "function_parameters": {
          "dict_param_name": "hash_groups",
          "target_param_name": "duplicate_groups",
          "minimum": 2
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "next": "WRITE_TABLE"
        },
        {
          "fail": "duplicates_lost"
        }
      ]
    },
    {
      "id": "DECIDE",
      "action_type": "llm",
      "action_parameters": {
        "provider": "local",
        "prompt": "You are reorganizing the folder ${param.scan_root}. The inventory below was collected by the run you are part of: every file was hashed and classified, and files sharing one content hash were grouped in code, so a group listing more than one path is a set of identical copies - that finding is established, do not re-derive it.\n\nThe inventory rows, one per file (folder, name, size, MIME type, MD5):\n${param.table_rows}\n\nThe category of every file, keyed by its path:\n${param.file_categories}\n\nThe duplicate groups, identical files keyed by their shared hash:\n${param.duplicate_groups}\n\nPropose a reorganization of this folder. Design a folder structure with one folder per category that actually occurs, using the category names as folder names. Assign every file of the inventory to exactly one target folder, normally the folder of its category; keep subfolder structure only where it separates files of one category that would otherwise collide by name. For every duplicate group, recommend which single copy to keep - prefer the shortest path, then the alphabetically first - and list every other copy of the group for deletion rather than for a move.\n\nAnswer as a JSON object with exactly three members. \"plan_text\": one JSON string - the whole prose inside one pair of double quotes - the plan a person reviews: what moves where and why, which duplicates to delete and which copy survives, at most fifteen sentences. \"moves\": a JSON object mapping the path of every file that is neither deleted nor already in place to its target folder relative to the root. \"counts_by_category\": a JSON object mapping each category name you used to the number of files you assigned to it; use only names from this list: ${param.categories}. Answer with the JSON object alone, without a preamble and without code fences.",
        "answer": [
          {
            "name": "plan_text",
            "description": "The reorganization plan as prose a person reviews"
          },
          {
            "name": "moves",
            "type": "dict",
            "description": "Source path to target folder, relative to the scan root"
          },
          {
            "name": "counts_by_category",
            "type": "dict",
            "description": "Files assigned per category, keys drawn from the configured category list"
          }
        ],
        "format": "json",
        "record": true
      },
      "max_attempts": 3,
      "transitions": [
        {
          "guard": {
            "all_of": [
              {
                "no_error": true
              },
              {
                "function_name": "is_answer_keys_valid",
                "function_parameters": {
                  "name": "counts_by_category",
                  "allowed": "param.categories"
                }
              }
            ]
          },
          "next": "WRITE_PLAN"
        },
        {
          "errors": [
            "transient",
            "rate_limited",
            "timeout",
            "llm_answer_invalid"
          ],
          "next": "DECIDE",
          "attempts": true
        },
        {
          "errors": [
            "context_overflow"
          ],
          "fail": "inventory_too_large"
        },
        {
          "guard": {
            "no_error": true
          },
          "next": "DECIDE",
          "attempts": true
        },
        {
          "fail": "plan_unusable"
        }
      ]
    },
    {
      "id": "WRITE_TABLE",
      "action_type": "function",
      "action_parameters": {
        "function_name": "dict_list_to_pretty_table",
        "function_parameters": {
          "artifact_name": "inventory_table",
          "dict_param_name": "table_rows",
          "artifact_path": "reports/inventory_table.csv",
          "table_format": "csv"
        }
      },
      "transitions": [
        {
          "errors": [
            "pretty_table_no_data"
          ],
          "fail": "nothing_to_plan"
        },
        {
          "guard": {
            "no_error": true
          },
          "next": "DECIDE"
        },
        {
          "fail": "table_unwritten"
        }
      ]
    },
    {
      "id": "WRITE_PLAN",
      "action_type": "function",
      "action_parameters": {
        "function_name": "render_template_to_artifact",
        "function_parameters": {
          "artifact_name": "reorg_plan",
          "template_path": "reorganize-folder-plan.tmpl",
          "artifact_path": "reports/reorg_plan.md",
          "artifact_description": "The reorganization plan: the model's prose, the machine-readable moves, the counts and the duplicate groups"
        }
      },
      "transitions": [
        {
          "guard": {
            "no_error": true
          },
          "stop": true
        },
        {
          "fail": "plan_unwritten"
        }
      ]
    }
  ]
}
